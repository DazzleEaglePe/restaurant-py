// Esquema de la base de datos. La referencia es docs/05_MODELO_DATOS.md; cada
// sprint agrega las tablas que necesita. Las restricciones CHECK y las políticas
// de Row Level Security viven en las migraciones, porque Prisma no las modela.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pgcrypto, pg_trgm]
}

enum EstadoNegocio {
  ACTIVO
  SUSPENDIDO

  @@map("estado_negocio")
}

enum RolUsuario {
  OWNER
  ADMIN
  CAJERO
  MESERO

  @@map("rol_usuario")
}

enum EstadoCobrosLocal {
  ACTIVO
  DEMORADO
  DESCONECTADO
  SIN_SERVICIO
  CONEXION_INVALIDA
  SIN_CELULAR

  @@map("estado_cobros_local")
}

/// §3.2
model Negocio {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombreComercial String        @map("nombre_comercial") @db.VarChar(120)
  razonSocial     String?       @map("razon_social") @db.VarChar(160)
  ruc             String?       @db.Char(11)
  zonaHoraria     String        @default("America/Lima") @map("zona_horaria") @db.VarChar(64)
  logoUrl         String?       @map("logo_url")
  colorAcento     String?       @map("color_acento") @db.Char(7)
  estado          EstadoNegocio @default(ACTIVO)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  locales          Local[]
  membresias       Membresia[]
  membresiaLocales MembresiaLocal[]
  auditoria        Auditoria[]
  refreshTokens    RefreshToken[]
  categorias       Categoria[]
  productos        Producto[]
  comboComponentes ComboComponente[]
  productoLocales  ProductoLocal[]

  @@map("negocios")
}

/// §3.2. La configuración operativa es la de RF-TEN-003.
model Local {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  nombre             String            @db.VarChar(80)
  direccion          String?           @db.VarChar(200)
  activo             Boolean           @default(true)
  ventanaPagosMin    Int               @default(15) @map("ventana_pagos_min") @db.SmallInt
  permiteConstancia  Boolean           @default(true) @map("permite_constancia")
  montoMaxConstancia Decimal?          @map("monto_max_constancia") @db.Decimal(10, 2)
  mesaObligatoria    Boolean           @default(false) @map("mesa_obligatoria")
  cocinaAlertaMin    Int               @default(10) @map("cocina_alerta_min") @db.SmallInt
  cocinaCriticoMin   Int               @default(20) @map("cocina_critico_min") @db.SmallInt
  ocultarListosMin   Int               @default(10) @map("ocultar_listos_min") @db.SmallInt
  tiempoBaseMin      Int               @default(20) @map("tiempo_base_min") @db.SmallInt
  costoTaperDefecto  Decimal           @default(1.00) @map("costo_taper_defecto") @db.Decimal(10, 2)
  estadoCobros       EstadoCobrosLocal @default(SIN_CELULAR) @map("estado_cobros")
  estadoCobrosDesde  DateTime          @default(now()) @map("estado_cobros_desde") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  negocio          Negocio          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membresiaLocales MembresiaLocal[]
  productoLocales  ProductoLocal[]

  @@unique([tenantId, nombre])
  // Destino de las claves compuestas de membresia_locales y producto_locales.
  @@unique([id, tenantId])
  @@map("locales")
}

/// §3.2. Un usuario puede pertenecer a varios negocios; por eso no tiene `tenant_id`.
model Usuario {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String    @unique @db.Citext
  nombre           String    @db.VarChar(80)
  /// null hasta aceptar la invitación.
  passwordHash     String?   @map("password_hash")
  intentosFallidos Int       @default(0) @map("intentos_fallidos") @db.SmallInt
  bloqueadoHasta   DateTime? @map("bloqueado_hasta") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  membresias    Membresia[]
  refreshTokens RefreshToken[]
  tokensUnUso   TokenUnUso[]

  @@map("usuarios")
}

model Membresia {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  usuarioId String     @map("usuario_id") @db.Uuid
  rol       RolUsuario
  activa    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  negocio Negocio          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuario Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  locales MembresiaLocal[]

  @@unique([tenantId, usuarioId])
  @@unique([id, tenantId])
  @@map("membresias")
}

/// Locales en los que puede operar un CAJERO o un MESERO. OWNER y ADMIN operan en todos.
/// Las relaciones incluyen `tenant_id`: una clave foránea no respeta RLS, y sin
/// ella una membresía de un negocio podría apuntar a un local de otro.
model MembresiaLocal {
  membresiaId String @map("membresia_id") @db.Uuid
  localId     String @map("local_id") @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid

  membresia Membresia @relation(fields: [membresiaId, tenantId], references: [id, tenantId], onDelete: Cascade)
  local     Local     @relation(fields: [localId, tenantId], references: [id, tenantId], onDelete: Cascade)
  negocio   Negocio   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([membresiaId, localId])
  @@map("membresia_locales")
}

/// Una sesión: la familia agrupa los tokens que se rotan desde un mismo ingreso.
/// `tenant_id` es el negocio activo de la sesión, que vuelve al renovar el access token.
model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  familiaId  String    @map("familia_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiraAt   DateTime  @map("expira_at") @db.Timestamptz(6)
  usadoAt    DateTime? @map("usado_at") @db.Timestamptz(6)
  revocadoAt DateTime? @map("revocado_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  negocio Negocio @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([familiaId])
  @@map("refresh_tokens")
}

/// Invitación y recuperación de contraseña.
model TokenUnUso {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  proposito String    @db.VarChar(24)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiraAt  DateTime  @map("expira_at") @db.Timestamptz(6)
  usadoAt   DateTime? @map("usado_at") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("tokens_un_uso")
}

/// §3.10
model Auditoria {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  localId     String?  @map("local_id") @db.Uuid
  accion      String   @db.VarChar(60)
  actorTipo   String   @map("actor_tipo") @db.VarChar(16)
  actorId     String?  @map("actor_id") @db.Uuid
  recursoTipo String   @map("recurso_tipo") @db.VarChar(40)
  recursoId   String?  @map("recurso_id") @db.Uuid
  datos       Json     @default("{}")
  ip          String?  @db.Inet
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  negocio Negocio @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)], map: "auditoria_negocio_fecha")
  @@map("auditoria")
}

/// §3.11. Cuentas internas de Tab Group, aparte de los usuarios de los negocios.
/// La aplicación no las ve: la tabla tiene RLS sin políticas y solo el rol de
/// plataforma (BYPASSRLS) la lee (docs/07_SEGURIDAD_AUTH.md §11).
model AdministradorPlataforma {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.Citext
  nombre       String   @db.VarChar(80)
  passwordHash String   @map("password_hash")
  /// Secreto TOTP cifrado con AES-256-GCM (ENCRYPTION_KEY).
  totpSecreto  Bytes    @map("totp_secreto")
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("administradores_plataforma")
}

// ---------------------------------------------------------------------------
// §3.4. Carta (Sprint 2). Los grupos de opciones (RF-CAR-004, COULD) no se crean
// en el MVP: los combos del piloto son fijos (D9).
// ---------------------------------------------------------------------------

model Categoria {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nombre    String   @db.VarChar(60)
  orden     Int      @default(0) @db.SmallInt
  activa    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  negocio   Negocio    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productos Producto[]

  @@unique([tenantId, nombre])
  @@unique([id, tenantId])
  @@map("categorias")
}

model Producto {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  categoriaId    String   @map("categoria_id") @db.Uuid
  nombre         String   @db.VarChar(80)
  descripcion    String?  @db.VarChar(300)
  precio         Decimal  @db.Decimal(10, 2)
  /// Costo del táper para llevar (D18).
  costoTaper     Decimal  @default(0) @map("costo_taper") @db.Decimal(10, 2)
  fotoUrl        String?  @map("foto_url")
  esCombo        Boolean  @default(false) @map("es_combo")
  requiereCocina Boolean  @default(true) @map("requiere_cocina")
  orden          Int      @default(0) @db.SmallInt
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  negocio     Negocio           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoria   Categoria         @relation(fields: [categoriaId, tenantId], references: [id, tenantId], onDelete: NoAction)
  componentes ComboComponente[] @relation("combo")
  enCombos    ComboComponente[] @relation("componente")
  locales     ProductoLocal[]

  @@unique([tenantId, nombre])
  @@unique([id, tenantId])
  @@index([tenantId, categoriaId, orden])
  @@map("productos")
}

/// Platos fijos de un combo (RF-CAR-003).
model ComboComponente {
  comboId    String @map("combo_id") @db.Uuid
  productoId String @map("producto_id") @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  cantidad   Int    @default(1) @db.SmallInt

  negocio  Negocio  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  combo    Producto @relation("combo", fields: [comboId, tenantId], references: [id, tenantId], onDelete: Cascade)
  producto Producto @relation("componente", fields: [productoId, tenantId], references: [id, tenantId], onDelete: NoAction)

  @@id([comboId, productoId])
  @@map("combo_componentes")
}

/// Disponibilidad, agotado y precio por local (RF-CAR-006, 007 y 009). Sin fila,
/// el producto está habilitado, no agotado y con su precio general.
model ProductoLocal {
  productoId  String   @map("producto_id") @db.Uuid
  localId     String   @map("local_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  habilitado  Boolean  @default(true)
  agotado     Boolean  @default(false)
  precioLocal Decimal? @map("precio_local") @db.Decimal(10, 2)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  negocio  Negocio  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId, tenantId], references: [id, tenantId], onDelete: Cascade)
  local    Local    @relation(fields: [localId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([productoId, localId])
  @@map("producto_locales")
}
