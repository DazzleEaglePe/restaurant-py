{
  "name": "@resto/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    "./cn": {
      "types": "./dist/lib/cn.d.ts",
      "default": "./dist/lib/cn.js"
    },
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "default": "./dist/tailwind-preset.js"
    },
    "./componentes": {
      "types": "./dist/componentes/index.d.ts",
      "default": "./dist/componentes/index.js"
    }
  },
  "dependencies": {
    "@resto/design-tokens": "workspace:*",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@resto/config-eslint": "workspace:*",
    "@resto/config-typescript": "workspace:*",
    "@types/react": "19.1.12",
    "eslint": "9.39.5",
    "react": "19.1.0",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
