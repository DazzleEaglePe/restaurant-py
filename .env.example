# Variables de desarrollo local (docs/11_ESTRUCTURA_PROYECTO.md §12).
# Copia este archivo a .env y agrega las claves con:
#   ./tools/scripts/generate-keys.sh >> .env

# --- API y worker ---
NODE_ENV=development
PORT=4001
WEB_URL=http://localhost:4000
PUBLIC_API_URL=http://localhost:4001

# La aplicación se conecta con resto_app (sujeto a RLS); las migraciones y la
# semilla, con el propietario. La consola de plataforma usa resto_plataforma.
DATABASE_URL=postgresql://resto_app:resto_app_dev@localhost:5433/resto
DIRECT_DATABASE_URL=postgresql://resto:resto_dev@localhost:5433/resto
DATABASE_PLATFORM_URL=postgresql://resto_plataforma:resto_plataforma_dev@localhost:5433/resto
REDIS_URL=redis://localhost:6380

# Consola de plataforma: su origen, e IPs o subredes permitidas separadas por coma.
# Sin IPs, en desarrollo se permite todo. Detrás de un proxy, de quién aceptar
# X-Forwarded-For.
PLATAFORMA_URL=http://localhost:4002
PLATAFORMA_IPS=
TRUST_PROXY=

SMTP_URL=smtp://localhost:1026
MAIL_FROM="resto <no-responder@resto.test>"
YALLEGO_BASE_URL=http://localhost:4010/v1
YALLEGO_TIMEOUT_MS=5000

# Contraseña de los usuarios de la «Cevichería Demo». Solo desarrollo.
SEED_PASSWORD=

# Generadas por tools/scripts/generate-keys.sh: JWT_PRIVATE_KEY, JWT_PUBLIC_KEY
# y ENCRYPTION_KEY.

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_PUBLIC_WS_URL=ws://localhost:4001
NEXT_PUBLIC_APP_NAME=resto
